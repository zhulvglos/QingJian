{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻笺 V1",
  "version": "0.10.3",
  "identifier": "com.shushin.qingjian.shell",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻笺 V1",
        "width": 327,
        "visible": false,
        "height": 720,
        "minWidth": 326,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
